# IsoformVUS .gitignore
# Principle: exclude large downloads and intermediates; INCLUDE the small
# derived results, figures, and processed tables that the publication shares.
# data/raw/ (genome FASTA, ClinVar VCF, etc., ~5 GB) and data/interim/
# (SpliceAI VCFs, ~3 GB) are regenerated via scripts/01_* and documented in
# docs/data.md — they must NOT be committed.

# Large raw downloads and intermediates (regenerable)
data/raw/
data/interim/*
# ...but the five stage-18 input tables ARE committed: they cannot be
# regenerated (the code that built them was removed with the experiment
# archive), and without them stage 18 and figures 09-12 do not run.
!data/interim/script18/
data/interim/script18/*
!data/interim/script18/*.tsv.gz

# Deleted experiment archive; do not re-add
breakthrough/

# Large bioinformatics file types, wherever they appear
*.vcf.gz
*.vcf.gz.tbi
*.bcf
*.bam
*.cram
*.fastq.gz
*.fq.gz
*.gtf.gz
*.gff3.gz
*.fa
*.fasta
*.fasta.gz
*.fa.gz
*.2bit

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.pytest_cache/
*.log
# ...but the test-access log IS committed: it is the audit record for the
# locked test set (results/test_access.log is a reconstructed record;
# see its header).
!results/test_access.log

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
